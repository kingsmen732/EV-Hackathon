# ---- Frontend (Vercel) ----
# Where the FastAPI backend runs (Render). Local default: http://127.0.0.1:8000
BACKEND_URL=https://ev-back.mithilesh.me/

# Ola Maps browser key for map tiles (public by design — restrict to your domain in the Ola console)
NEXT_PUBLIC_OLA_MAPS_API_KEY=
# NEXT_PUBLIC_OLA_MAPS_STYLE=https://api.olamaps.io/tiles/vector/v1/styles/default-dark-standard/style.json

# Canonical site URL for metadata / share previews
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Backend secrets live in backend/.env (local) and in Render's dashboard — not here.
