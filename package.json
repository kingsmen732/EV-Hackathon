{
  "name": "chargemesh",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"next dev\" \"npm run api\"",
    "web": "next dev",
    "api": "cd backend && python3 -m uvicorn evcore.api:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "cd backend && python3 -m pytest -q"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "15.5.26",
    "olamaps-web-sdk": "^1.4.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
